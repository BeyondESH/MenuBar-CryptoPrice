<Page
    x:Class="MenuBarCryptoPrice.Settings.WinUI.Pages.MarketPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:MenuBarCryptoPrice.Settings.WinUI.ViewModels">

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto"
        Padding="36,24,36,48">
        <StackPanel MaxWidth="1000" HorizontalAlignment="Stretch" Spacing="12">

            <Grid>
                <TextBlock Text="行情" Style="{StaticResource TitleTextBlockStyle}" />
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{x:Bind ViewModel.LiveBrush, Mode=OneWay}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.LiveStatus, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
            <TextBlock
                Text="选择任务栏显示的币种、顺序与数量。修改会立即保存并同步到任务栏。"
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />

            <controls:SettingsCard
                Header="显示数量"
                Description="任务栏最多显示的币种数量；超出部分折叠为 +N。">
                <ComboBox
                    MinWidth="140"
                    SelectedIndex="{x:Bind ViewModel.MaxVisibleIndex, Mode=OneWay}"
                    DropDownClosed="OnMaxVisibleDropDownClosed">
                    <ComboBoxItem Content="1" />
                    <ComboBoxItem Content="2" />
                    <ComboBoxItem Content="3" />
                    <ComboBoxItem Content="4" />
                    <ComboBoxItem Content="5" />
                    <ComboBoxItem Content="6" />
                    <ComboBoxItem Content="7" />
                    <ComboBoxItem Content="8" />
                </ComboBox>
            </controls:SettingsCard>

            <Grid Margin="0,10,0,0">
                <TextBlock
                    Text="币种"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    VerticalAlignment="Center" />
                <Button
                    HorizontalAlignment="Right"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="OnAddClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="添加币种" />
                    </StackPanel>
                </Button>
            </Grid>

            <ItemsControl ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ItemRowViewModel">
                        <controls:SettingsCard
                            Header="{x:Bind DisplayName}"
                            Description="{x:Bind DescriptionText, Mode=OneWay}"
                            Margin="0,0,0,4"
                            Opacity="{x:Bind RowOpacity, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock
                                    Text="超出"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                    Visibility="{x:Bind LimitVisibility, Mode=OneWay}"
                                    VerticalAlignment="Center" />

                                <StackPanel MinWidth="92" VerticalAlignment="Center">
                                    <TextBlock
                                        Text="{x:Bind PriceText, Mode=OneWay}"
                                        FontFamily="Consolas"
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        HorizontalAlignment="Right" />
                                    <TextBlock
                                        Text="{x:Bind ChangeText, Mode=OneWay}"
                                        Foreground="{x:Bind ChangeBrush, Mode=OneWay}"
                                        FontSize="12"
                                        HorizontalAlignment="Right" />
                                </StackPanel>

                                <TextBlock
                                    Text="24h"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    VerticalAlignment="Center" />
                                <Canvas
                                    Width="60"
                                    Height="8"
                                    VerticalAlignment="Center"
                                    Visibility="{x:Bind RangeVisibility, Mode=OneWay}"
                                    ToolTipService.ToolTip="{x:Bind RangeTooltip, Mode=OneWay}">
                                    <Rectangle
                                        Width="60"
                                        Height="3"
                                        Canvas.Top="2.5"
                                        RadiusX="1.5"
                                        RadiusY="1.5"
                                        Fill="{ThemeResource ControlStrongFillColorDefaultBrush}" />
                                    <Ellipse
                                        Width="8"
                                        Height="8"
                                        Canvas.Top="0"
                                        Canvas.Left="{x:Bind RangeDotLeft, Mode=OneWay}"
                                        Fill="{x:Bind ChangeBrush, Mode=OneWay}" />
                                </Canvas>

                                <ComboBox
                                    MinWidth="92"
                                    FontSize="12"
                                    VerticalAlignment="Center"
                                    SelectedIndex="{x:Bind MarketIndex, Mode=OneWay}"
                                    DropDownClosed="OnMarketDropDownClosed">
                                    <ComboBoxItem Content="现货" />
                                    <ComboBoxItem Content="永续" />
                                </ComboBox>

                                <Button
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    IsEnabled="{x:Bind CanMoveUp, Mode=OneWay}"
                                    Click="OnMoveUpClick"
                                    ToolTipService.ToolTip="上移">
                                    <FontIcon Glyph="&#xE74A;" FontSize="13" />
                                </Button>
                                <Button
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    IsEnabled="{x:Bind CanMoveDown, Mode=OneWay}"
                                    Click="OnMoveDownClick"
                                    ToolTipService.ToolTip="下移">
                                    <FontIcon Glyph="&#xE74B;" FontSize="13" />
                                </Button>
                                <Button
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="OnRemoveClick"
                                    ToolTipService.ToolTip="删除">
                                    <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                </Button>
                            </StackPanel>
                        </controls:SettingsCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock
                Text="提示：悬停任务栏价格可查看完整行情；悬停 +N 可查看全部币种。"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                TextWrapping="Wrap"
                Margin="0,4,0,0" />

            <controls:SettingsCard
                Header="币种目录"
                Description="{x:Bind ViewModel.CatalogStatus, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <ProgressRing
                        Width="20"
                        Height="20"
                        IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                    <Button Content="刷新目录" Click="OnRefreshCatalogClick" />
                </StackPanel>
            </controls:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>
