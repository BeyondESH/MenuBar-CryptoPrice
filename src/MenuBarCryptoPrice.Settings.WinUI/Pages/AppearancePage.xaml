<Page
    x:Class="MenuBarCryptoPrice.Settings.WinUI.Pages.AppearancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto"
        HorizontalContentAlignment="Stretch"
        VerticalContentAlignment="Top"
        Padding="36,24,36,48">
        <StackPanel HorizontalAlignment="Stretch" Spacing="12">

            <TextBlock Text="外观" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                Text="调整任务栏条目的布局、字号、颜色与停靠方式。修改会立即保存。"
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />

            <controls:SettingsCard Header="布局" Description="单行更紧凑；双行显示更多信息。">
                <ComboBox
                    MinWidth="160"
                    SelectedIndex="{x:Bind ViewModel.LayoutIndex, Mode=OneWay}"
                    DropDownClosed="OnLayoutDropDownClosed">
                    <ComboBoxItem Content="单行" />
                    <ComboBoxItem Content="双行紧凑" />
                </ComboBox>
            </controls:SettingsCard>

            <controls:SettingsCard Header="字号" Description="任务栏条目的文字大小。">
                <ComboBox
                    MinWidth="160"
                    SelectedIndex="{x:Bind ViewModel.FontSizeIndex, Mode=OneWay}"
                    DropDownClosed="OnFontSizeDropDownClosed">
                    <ComboBoxItem Content="小" />
                    <ComboBoxItem Content="中" />
                    <ComboBoxItem Content="大" />
                    <ComboBoxItem Content="特大" />
                </ComboBox>
            </controls:SettingsCard>

            <controls:SettingsCard Header="涨跌颜色" Description="选择上涨与下跌使用的颜色。">
                <ComboBox
                    MinWidth="160"
                    SelectedIndex="{x:Bind ViewModel.ColorSchemeIndex, Mode=OneWay}"
                    DropDownClosed="OnColorSchemeDropDownClosed">
                    <ComboBoxItem Content="绿涨红跌" />
                    <ComboBoxItem Content="红涨绿跌" />
                </ComboBox>
            </controls:SettingsCard>

            <controls:SettingsCard Header="位置" Description="显示在任务栏内，或悬浮在任务栏上方。">
                <ComboBox
                    MinWidth="160"
                    SelectedIndex="{x:Bind ViewModel.PositionIndex, Mode=OneWay}"
                    DropDownClosed="OnPositionDropDownClosed">
                    <ComboBoxItem Content="任务栏内" />
                    <ComboBoxItem Content="任务栏上方" />
                </ComboBox>
            </controls:SettingsCard>

            <controls:SettingsCard Header="贴靠方向" Description="优先使用任务栏左侧或右侧的空白区域。">
                <ComboBox
                    MinWidth="160"
                    SelectedIndex="{x:Bind ViewModel.AnchorIndex, Mode=OneWay}"
                    DropDownClosed="OnAnchorDropDownClosed">
                    <ComboBoxItem Content="右侧" />
                    <ComboBoxItem Content="左侧" />
                </ComboBox>
            </controls:SettingsCard>

            <controls:SettingsCard Header="开机自启" Description="登录 Windows 后自动启动任务栏行情。">
                <ToggleSwitch IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}" />
            </controls:SettingsCard>

            <controls:SettingsCard
                Header="溢出处理"
                Description="超出任务栏可用宽度时自动折叠为 +N；悬停 +N 可查看完整列表。" />

            <controls:SettingsCard Header="恢复默认设置" Description="恢复默认币种、数量与外观设置。">
                <Button Content="恢复默认" Click="OnRestoreClick" />
            </controls:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>
