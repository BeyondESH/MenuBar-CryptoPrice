<UserControl x:Class="MenuBarCryptoPrice.Controls.TickerStripControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <UserControl.Resources>
        <DataTemplate x:Key="StripItemTemplate">
            <Border Background="#01000000"
                    Cursor="Hand"
                    ToolTip="{Binding Tooltip}"
                    ToolTipService.Placement="Top"
                    ToolTipService.ShowDuration="20000">
                <Grid Width="{Binding TotalWidth}" Height="{Binding ItemHeight}">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Visibility="{Binding SingleLineVisibility}">
                        <TextBlock Text="{Binding Label}"
                                   FontSize="{Binding FontSizeDip}"
                                   FontWeight="SemiBold"
                                   Foreground="#F2F4F5"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding MarketBadge}"
                                   FontSize="{Binding SmallFontSizeDip}"
                                   Foreground="#A1A7AD"
                                   Margin="3,1,0,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding PriceText}"
                                   FontFamily="Consolas"
                                   FontSize="{Binding FontSizeDip}"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding PriceBrush}"
                                   Margin="4,0,0,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ChangeText}"
                                   FontFamily="Consolas"
                                   FontSize="{Binding SmallFontSizeDip}"
                                   Foreground="{Binding ChangeBrush}"
                                   Margin="4,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <Grid Visibility="{Binding TwoLineVisibility}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Label}"
                                       FontSize="{Binding FontSizeDip}"
                                       FontWeight="SemiBold"
                                       Foreground="#F2F4F5"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding MarketBadge}"
                                       FontSize="{Binding SmallFontSizeDip}"
                                       Foreground="#A1A7AD"
                                       Margin="3,1,0,0"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding PriceText}"
                                       FontFamily="Consolas"
                                       FontSize="{Binding FontSizeDip}"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding PriceBrush}"
                                       Margin="4,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Grid.Row="1"
                                   Text="{Binding ChangeText}"
                                   FontFamily="Consolas"
                                   FontSize="{Binding SmallFontSizeDip}"
                                   Foreground="{Binding ChangeBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid MouseLeftButtonUp="OnStripMouseLeftButtonUp">
        <StackPanel Orientation="Horizontal" Visibility="{Binding ContentVisibility}">
            <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource StripItemTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <Border Background="#01000000"
                    CornerRadius="5"
                    Padding="4,2"
                    Margin="2,0,2,0"
                    VerticalAlignment="Center"
                    Cursor="Hand"
                    Visibility="{Binding OverflowVisibility}"
                    ToolTip="{Binding OverflowTooltip}"
                    ToolTipService.Placement="Top"
                    ToolTipService.ShowDuration="30000"
                    MouseLeftButtonUp="OnOverflowMouseLeftButtonUp">
                <TextBlock Text="{Binding OverflowText}"
                           FontFamily="Consolas"
                           FontSize="{Binding FontSizeDip}"
                           FontWeight="SemiBold"
                           Foreground="#A1A7AD" />
            </Border>
        </StackPanel>

        <Button x:Name="EmptyButton"
                Content="{Binding EmptyText}"
                Visibility="{Binding EmptyVisibility}"
                Background="Transparent"
                BorderThickness="0"
                Foreground="#F2F4F5"
                FontSize="{Binding FontSizeDip}"
                Padding="2,0"
                Cursor="Hand"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Click="OnEmptyClick" />
    </Grid>
</UserControl>

